# Application Port & URLs
PORT=3000
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MongoDB Database Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/aurawave?retryWrites=true&w=majority
# If omitted, AuraWave automatically uses persistent local JSON storage for zero-config startup
MONGODB_URI="mongodb+srv://user:password@cluster0.mongodb.net/aurawave?retryWrites=true&w=majority"

# Better Auth Session Secret
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secret-random-32-byte-string-here"
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Google YouTube Data API v3 Key
# If omitted, YouTube oEmbed official metadata extractor is used automatically (zero-config)
YOUTUBE_API_KEY="AIzaSyYourYouTubeDataApiKey"

